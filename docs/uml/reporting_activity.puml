@startuml
title UML Activity - TG Build Bot Online Ingress Flow (Pilot)

start

partition Runtime {
  :Polling or webhook runtime is active;
}

partition User {
  :Open chat with bot;
  :Press /start;
}

partition BotOnline {
  :Send welcome message + main menu;
}

partition User {
  :Press Report Progress;
}

partition BotOnline {
  :Send input instruction;
}

partition User {
  :Send free-form progress message;
}

partition Telegram {
  :Receive update (Polling or Webhook);
}

partition BotOnline {
  :Log event message_received;
  :Preprocess text (trim, normalize spaces);
  :Build TelegramMessageMeta;
  :Load dictionaries from text files;
  :Build Gemini prompt;
  :Call Gemini via google-genai SDK (timeout 30 sec);
}

if (Gemini call successful?) then (yes)
  partition BotOnline {
    :Log event llm_response_received;
    :Normalize LLM payload;
    :Validate JSON schema + dictionary constraints;
  }

  if (JSON valid?) then (yes)
    partition BotOnline {
      :Log event json_validation_passed;
      :Build DataFactRecord;
      :Set status = PROCESSED;
    }
  else (no)
    partition BotOnline {
      :Log event json_validation_failed;
      :Build fallback DataFactRecord;
      :Set status = PROCESSED_WITH_FALLBACK;
    }
  endif

  partition SQLite {
    :Create PendingConfirmation draft;
  }

  partition BotOnline {
    :Send confirmation card (Confirm / Edit / Cancel);
  }

  if (User decision?) then (Confirm)
    partition SQLite {
      :Load PendingConfirmation by confirmation_id;
    }

    partition GoogleSheets {
      :Append confirmed row to data_facts;
    }

    if (Sheets write successful?) then (yes)
      partition SQLite {
        :Delete PendingConfirmation;
      }

      partition BotOnline {
        :Log event sheets_write_success;
        :Send Saved + post-save actions;
      }
      stop
    else (no)
      partition BotOnline {
        :Log event sheets_write_failed;
        :Send processing error;
      }
      note right
        The draft is intentionally kept,
        so the user can retry Confirm later.
      end note
      stop
    endif

  else (Edit)
    partition SQLite {
      :Delete PendingConfirmation draft;
    }

    partition BotOnline {
      :Send corrected input instruction;
    }
    note right
      User sends a corrected message and
      restarts the same online classification flow.
    end note
    stop

  else (Cancel)
    partition SQLite {
      :Delete PendingConfirmation draft;
    }

    partition BotOnline {
      :Send cancelled + main menu;
    }
    stop
  endif

else (no)
  if (Timeout?) then (yes)
    partition SQLite {
      :Build QueueTask;
      :Enqueue queue task;
    }

    if (Enqueue successful?) then (yes)
      partition BotOnline {
        :Log event queue_enqueued;
        :Send queued notice;
      }
      stop
    else (no)
      partition BotOnline {
        :Log event queue_enqueue_failed;
        :Send processing error;
      }
      stop
    endif

  else (error)
    partition BotOnline {
      :Log event classification_failed;
      :Send processing error;
    }
    stop
  endif
endif

note right
  This activity shows the primary online ingress path.
  Lightweight UI branches such as Help, Show Example,
  and input cancel are omitted for readability.

  Queue worker processing is documented separately in:
  docs/uml/reporting_queue_worker_activity.puml
end note

@enduml
