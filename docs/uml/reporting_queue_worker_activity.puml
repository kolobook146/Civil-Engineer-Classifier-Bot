@startuml
title UML Activity - TG Build Bot Queue Worker Flow (Pilot)

start

partition QueueWorkerProcess {
  :Log event queue_worker_bootstrap_started;
  :Optional startup preflight for queue path\n(only if STARTUP_PREFLIGHT_ENABLED=true);
  :Log event queue_worker_started;
  :Polling tick (QUEUE_POLL_INTERVAL_SECONDS);
  :Dequeue oldest due queue task;
}

if (Task found?) then (yes)
  partition QueueWorker {
    :Log event queue_dequeued;
    :Build TelegramMessageMeta;
    :Load dictionaries from text files;
    :Build Gemini prompt from queued payload;
    :Call Gemini via google-genai SDK;
  }

  if (Gemini call successful?) then (yes)
    partition QueueWorker {
      :Log event llm_response_received;
      :Normalize LLM payload;
      :Validate JSON schema + dictionary constraints;
    }

    if (JSON valid?) then (yes)
      partition QueueWorker {
        :Log event json_validation_passed;
        :Build DataFactRecord;
        :Set status = PROCESSED_FROM_QUEUE;
      }
    else (no)
      partition QueueWorker {
        :Log event json_validation_failed;
        :Build fallback DataFactRecord;
        :Set status = PROCESSED_FROM_QUEUE_FALLBACK;
      }
    endif

    partition SQLite {
      :Create PendingConfirmation draft;
    }

    partition QueueWorker {
      :Send post-factum confirmation card;
      :Log event post_factum_notification_sent;
    }

    if (Notification sent?) then (yes)
      partition SQLite {
        :Mark queue task done;
      }
      note right
        Google Sheets write does not happen here.
        The same Confirm callback used in the online flow
        persists the record later.
      end note
      stop
    else (no)
      partition SQLite {
        :Delete PendingConfirmation draft;
        :Requeue task with backoff + jitter;
      }

      partition QueueWorker {
        :Log event queue_processing_failed;
      }
      stop
    endif

  else (no)
    if (Timeout?) then (yes)
      partition SQLite {
        :Requeue task with backoff + jitter;
      }

      partition QueueWorker {
        :Log event llm_timeout;
        :Log event queue_enqueued (requeue_reason=llm_timeout);
      }
      stop

    else (error)
      partition SQLite {
        :Requeue task with backoff + jitter;
      }

      partition QueueWorker {
        :Log event queue_processing_failed;
      }
      stop
    endif
  endif

else (no)
  partition QueueWorker {
    :No due queue task on this poll tick;
  }
  stop
endif

note right
  This activity describes one queue-worker iteration.
  Runtime loops forever with sleep between polling ticks.

  Confirm / Edit / Cancel handling is shared with
  TelegramPollingHandler and is documented in the online flow.
end note

@enduml
