<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_CivilEngineerClassifierBot"
                  targetNamespace="https://example.local/bpmn/civil-engineer-classifier-bot">

  <bpmn:process id="Process_CivilEngineerClassifierBot"
                name="Civil Engineer's Classifier Bot (Pilot: polling/webhook + queue + explicit confirmation)"
                isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start_UserOpensChat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_OpenChat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_PressStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_PressReportProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_SendFreeText</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmationAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_ConfirmRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_EditRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>User_CancelRecord</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Telegram" name="Telegram">
        <bpmn:flowNodeRef>TG_ReceiveUpdate</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Bot" name="Bot Backend (Online Path)">
        <bpmn:flowNodeRef>Bot_SendWelcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendInputInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_PreprocessText</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_LoadDictionariesOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_BuildPromptOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_CallGeminiOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnlineLlmOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_NormalizeValidateOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnlineJsonValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_BuildValidRecordOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_BuildFallbackRecordOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendConfirmationRequestOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendQueuedNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendProcessingErrorOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendCorrectedInputInstruction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendPendingCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendRecordSaved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bot_SendProcessingErrorOnSave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OnlineQueued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OnlineFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RecordCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RecordSaved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SaveFailedDraftKept</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Stores" name="SQLite Stores (Queue + Pending Confirmations)">
        <bpmn:flowNodeRef>Store_EnqueueQueueTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnqueueOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_CreatePendingConfirmationOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_LoadPendingConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_DeletePendingAfterSave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_DeletePendingOnEdit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_DeletePendingOnCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_CreatePendingConfirmationQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_MarkQueueDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_DeletePendingOnNotificationFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store_RequeueTask</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_QueueWorker" name="Queue Worker">
        <bpmn:flowNodeRef>Start_QueuePollingTick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_DequeueDueTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QueueTaskFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_LoadDictionaries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_BuildPrompt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_CallGemini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QueueLlmOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_NormalizeValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QueueJsonValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_BuildValidRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_BuildFallbackRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Queue_SendPostFactumConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostFactumSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_QueueIdle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_QueueDeferred</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sheets" name="Google Sheets">
        <bpmn:flowNodeRef>Sheets_WriteConfirmedRecord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SheetsWriteSucceeded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_UserOpensChat" name="User opens bot chat"/>
    <bpmn:userTask id="User_OpenChat" name="Open chat with bot"/>
    <bpmn:userTask id="User_PressStart" name="Press /start"/>
    <bpmn:serviceTask id="Bot_SendWelcome" name="Send welcome message + main menu"/>
    <bpmn:userTask id="User_PressReportProgress" name="Press Report Progress"/>
    <bpmn:serviceTask id="Bot_SendInputInstruction" name="Send input instruction"/>
    <bpmn:userTask id="User_SendFreeText" name="Send free-form progress message"/>
    <bpmn:serviceTask id="TG_ReceiveUpdate" name="Receive Telegram update (Polling or Webhook)"/>

    <bpmn:serviceTask id="Bot_PreprocessText" name="Preprocess text + log message_received"/>
    <bpmn:serviceTask id="Bot_LoadDictionariesOnline" name="Load dictionaries from text files"/>
    <bpmn:serviceTask id="Bot_BuildPromptOnline" name="Build Gemini prompt"/>
    <bpmn:serviceTask id="Bot_CallGeminiOnline" name="Call Gemini (timeout 30s)"/>
    <bpmn:exclusiveGateway id="Gateway_OnlineLlmOutcome" name="Online Gemini outcome?"/>
    <bpmn:serviceTask id="Bot_NormalizeValidateOnline" name="Normalize payload + validate schema/dictionaries"/>
    <bpmn:exclusiveGateway id="Gateway_OnlineJsonValid" name="Online JSON valid?"/>
    <bpmn:serviceTask id="Bot_BuildValidRecordOnline" name="Build record (status=PROCESSED)"/>
    <bpmn:serviceTask id="Bot_BuildFallbackRecordOnline" name="Build fallback record (status=PROCESSED_WITH_FALLBACK)"/>
    <bpmn:serviceTask id="Store_CreatePendingConfirmationOnline" name="Create pending confirmation draft"/>
    <bpmn:serviceTask id="Bot_SendConfirmationRequestOnline" name="Send confirmation card (Confirm / Edit / Cancel)"/>

    <bpmn:serviceTask id="Store_EnqueueQueueTask" name="Enqueue queue task (raw_text + normalized_text + meta)"/>
    <bpmn:exclusiveGateway id="Gateway_EnqueueOk" name="Queue enqueue succeeded?"/>
    <bpmn:serviceTask id="Bot_SendQueuedNotice" name="Notify user: queued for deferred processing"/>
    <bpmn:serviceTask id="Bot_SendProcessingErrorOnline" name="Notify user: processing failed"/>

    <bpmn:exclusiveGateway id="Gateway_ConfirmationAction" name="User confirmation action?"/>
    <bpmn:userTask id="User_ConfirmRecord" name="Press Confirm"/>
    <bpmn:userTask id="User_EditRecord" name="Press Edit"/>
    <bpmn:userTask id="User_CancelRecord" name="Press Cancel"/>

    <bpmn:serviceTask id="Store_LoadPendingConfirmation" name="Load pending confirmation by confirmation_id"/>
    <bpmn:serviceTask id="Sheets_WriteConfirmedRecord" name="Append confirmed row to data_facts"/>
    <bpmn:exclusiveGateway id="Gateway_SheetsWriteSucceeded" name="Sheets write succeeded?"/>
    <bpmn:serviceTask id="Store_DeletePendingAfterSave" name="Delete pending confirmation after successful save"/>
    <bpmn:serviceTask id="Bot_SendRecordSaved" name="Notify user: Saved + post-save actions"/>
    <bpmn:serviceTask id="Bot_SendProcessingErrorOnSave" name="Notify user: save failed (draft kept)"/>

    <bpmn:serviceTask id="Store_DeletePendingOnEdit" name="Delete pending confirmation for edit"/>
    <bpmn:serviceTask id="Bot_SendCorrectedInputInstruction" name="Ask user to send corrected message"/>
    <bpmn:serviceTask id="Store_DeletePendingOnCancel" name="Delete pending confirmation on cancel"/>
    <bpmn:serviceTask id="Bot_SendPendingCancelled" name="Notify user: draft cancelled + main menu"/>

    <bpmn:startEvent id="Start_QueuePollingTick" name="Queue worker polling tick">
      <bpmn:timerEventDefinition id="TimerEvent_QueueTick"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Queue_DequeueDueTask" name="Dequeue due queue task"/>
    <bpmn:exclusiveGateway id="Gateway_QueueTaskFound" name="Due task found?"/>
    <bpmn:serviceTask id="Queue_LoadDictionaries" name="Queue: load dictionaries"/>
    <bpmn:serviceTask id="Queue_BuildPrompt" name="Queue: build Gemini prompt"/>
    <bpmn:serviceTask id="Queue_CallGemini" name="Queue: call Gemini"/>
    <bpmn:exclusiveGateway id="Gateway_QueueLlmOutcome" name="Queue Gemini outcome?"/>
    <bpmn:serviceTask id="Queue_NormalizeValidate" name="Queue: normalize payload + validate schema/dictionaries"/>
    <bpmn:exclusiveGateway id="Gateway_QueueJsonValid" name="Queue JSON valid?"/>
    <bpmn:serviceTask id="Queue_BuildValidRecord" name="Build record (status=PROCESSED_FROM_QUEUE)"/>
    <bpmn:serviceTask id="Queue_BuildFallbackRecord" name="Build fallback record (status=PROCESSED_FROM_QUEUE_FALLBACK)"/>
    <bpmn:serviceTask id="Store_CreatePendingConfirmationQueue" name="Create post-factum pending confirmation draft"/>
    <bpmn:serviceTask id="Queue_SendPostFactumConfirmation" name="Send post-factum confirmation card"/>
    <bpmn:exclusiveGateway id="Gateway_PostFactumSent" name="Post-factum confirmation sent?"/>
    <bpmn:serviceTask id="Store_MarkQueueDone" name="Mark queue task done"/>
    <bpmn:serviceTask id="Store_DeletePendingOnNotificationFailure" name="Delete pending draft if notification failed"/>
    <bpmn:serviceTask id="Store_RequeueTask" name="Requeue task with backoff + log queue_processing_failed/queue_enqueued"/>

    <bpmn:endEvent id="End_OnlineQueued" name="Done (queued)"/>
    <bpmn:endEvent id="End_OnlineFailed" name="Done (online error)"/>
    <bpmn:endEvent id="End_RecordCancelled" name="Done (draft cancelled)"/>
    <bpmn:endEvent id="End_RecordSaved" name="Done (saved to Sheets)"/>
    <bpmn:endEvent id="End_SaveFailedDraftKept" name="Done (save failed, draft kept)"/>
    <bpmn:endEvent id="End_QueueIdle" name="Done (no due task)"/>
    <bpmn:endEvent id="End_QueueDeferred" name="Done (requeued for later retry)"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_UserOpensChat" targetRef="User_OpenChat"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="User_OpenChat" targetRef="User_PressStart"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="User_PressStart" targetRef="Bot_SendWelcome"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Bot_SendWelcome" targetRef="User_PressReportProgress"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="User_PressReportProgress" targetRef="Bot_SendInputInstruction"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Bot_SendInputInstruction" targetRef="User_SendFreeText"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="User_SendFreeText" targetRef="TG_ReceiveUpdate"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="TG_ReceiveUpdate" targetRef="Bot_PreprocessText"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Bot_PreprocessText" targetRef="Bot_LoadDictionariesOnline"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Bot_LoadDictionariesOnline" targetRef="Bot_BuildPromptOnline"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Bot_BuildPromptOnline" targetRef="Bot_CallGeminiOnline"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Bot_CallGeminiOnline" targetRef="Gateway_OnlineLlmOutcome"/>
    <bpmn:sequenceFlow id="Flow_13_success" sourceRef="Gateway_OnlineLlmOutcome" targetRef="Bot_NormalizeValidateOnline" name="Success"/>
    <bpmn:sequenceFlow id="Flow_13_timeout" sourceRef="Gateway_OnlineLlmOutcome" targetRef="Store_EnqueueQueueTask" name="Timeout"/>
    <bpmn:sequenceFlow id="Flow_13_error" sourceRef="Gateway_OnlineLlmOutcome" targetRef="Bot_SendProcessingErrorOnline" name="Error"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Bot_NormalizeValidateOnline" targetRef="Gateway_OnlineJsonValid"/>
    <bpmn:sequenceFlow id="Flow_15_yes" sourceRef="Gateway_OnlineJsonValid" targetRef="Bot_BuildValidRecordOnline" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_15_no" sourceRef="Gateway_OnlineJsonValid" targetRef="Bot_BuildFallbackRecordOnline" name="No"/>
    <bpmn:sequenceFlow id="Flow_16a" sourceRef="Bot_BuildValidRecordOnline" targetRef="Store_CreatePendingConfirmationOnline"/>
    <bpmn:sequenceFlow id="Flow_16b" sourceRef="Bot_BuildFallbackRecordOnline" targetRef="Store_CreatePendingConfirmationOnline"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Store_CreatePendingConfirmationOnline" targetRef="Bot_SendConfirmationRequestOnline"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Bot_SendConfirmationRequestOnline" targetRef="Gateway_ConfirmationAction"/>

    <bpmn:sequenceFlow id="Flow_19_confirm" sourceRef="Gateway_ConfirmationAction" targetRef="User_ConfirmRecord" name="Confirm"/>
    <bpmn:sequenceFlow id="Flow_19_edit" sourceRef="Gateway_ConfirmationAction" targetRef="User_EditRecord" name="Edit"/>
    <bpmn:sequenceFlow id="Flow_19_cancel" sourceRef="Gateway_ConfirmationAction" targetRef="User_CancelRecord" name="Cancel"/>

    <bpmn:sequenceFlow id="Flow_20" sourceRef="User_ConfirmRecord" targetRef="Store_LoadPendingConfirmation"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Store_LoadPendingConfirmation" targetRef="Sheets_WriteConfirmedRecord"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Sheets_WriteConfirmedRecord" targetRef="Gateway_SheetsWriteSucceeded"/>
    <bpmn:sequenceFlow id="Flow_23_yes" sourceRef="Gateway_SheetsWriteSucceeded" targetRef="Store_DeletePendingAfterSave" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_23_no" sourceRef="Gateway_SheetsWriteSucceeded" targetRef="Bot_SendProcessingErrorOnSave" name="No"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Store_DeletePendingAfterSave" targetRef="Bot_SendRecordSaved"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Bot_SendRecordSaved" targetRef="End_RecordSaved"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Bot_SendProcessingErrorOnSave" targetRef="End_SaveFailedDraftKept"/>

    <bpmn:sequenceFlow id="Flow_27" sourceRef="User_EditRecord" targetRef="Store_DeletePendingOnEdit"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Store_DeletePendingOnEdit" targetRef="Bot_SendCorrectedInputInstruction"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Bot_SendCorrectedInputInstruction" targetRef="User_SendFreeText"/>

    <bpmn:sequenceFlow id="Flow_30" sourceRef="User_CancelRecord" targetRef="Store_DeletePendingOnCancel"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Store_DeletePendingOnCancel" targetRef="Bot_SendPendingCancelled"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Bot_SendPendingCancelled" targetRef="End_RecordCancelled"/>

    <bpmn:sequenceFlow id="Flow_33" sourceRef="Store_EnqueueQueueTask" targetRef="Gateway_EnqueueOk"/>
    <bpmn:sequenceFlow id="Flow_34_yes" sourceRef="Gateway_EnqueueOk" targetRef="Bot_SendQueuedNotice" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_34_no" sourceRef="Gateway_EnqueueOk" targetRef="Bot_SendProcessingErrorOnline" name="No"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Bot_SendQueuedNotice" targetRef="End_OnlineQueued"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Bot_SendProcessingErrorOnline" targetRef="End_OnlineFailed"/>

    <bpmn:sequenceFlow id="Flow_40" sourceRef="Start_QueuePollingTick" targetRef="Queue_DequeueDueTask"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Queue_DequeueDueTask" targetRef="Gateway_QueueTaskFound"/>
    <bpmn:sequenceFlow id="Flow_42_no" sourceRef="Gateway_QueueTaskFound" targetRef="End_QueueIdle" name="No"/>
    <bpmn:sequenceFlow id="Flow_42_yes" sourceRef="Gateway_QueueTaskFound" targetRef="Queue_LoadDictionaries" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Queue_LoadDictionaries" targetRef="Queue_BuildPrompt"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Queue_BuildPrompt" targetRef="Queue_CallGemini"/>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Queue_CallGemini" targetRef="Gateway_QueueLlmOutcome"/>
    <bpmn:sequenceFlow id="Flow_46_success" sourceRef="Gateway_QueueLlmOutcome" targetRef="Queue_NormalizeValidate" name="Success"/>
    <bpmn:sequenceFlow id="Flow_46_timeout" sourceRef="Gateway_QueueLlmOutcome" targetRef="Store_RequeueTask" name="Timeout"/>
    <bpmn:sequenceFlow id="Flow_46_error" sourceRef="Gateway_QueueLlmOutcome" targetRef="Store_RequeueTask" name="Error"/>
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Queue_NormalizeValidate" targetRef="Gateway_QueueJsonValid"/>
    <bpmn:sequenceFlow id="Flow_48_yes" sourceRef="Gateway_QueueJsonValid" targetRef="Queue_BuildValidRecord" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_48_no" sourceRef="Gateway_QueueJsonValid" targetRef="Queue_BuildFallbackRecord" name="No"/>
    <bpmn:sequenceFlow id="Flow_49a" sourceRef="Queue_BuildValidRecord" targetRef="Store_CreatePendingConfirmationQueue"/>
    <bpmn:sequenceFlow id="Flow_49b" sourceRef="Queue_BuildFallbackRecord" targetRef="Store_CreatePendingConfirmationQueue"/>
    <bpmn:sequenceFlow id="Flow_50" sourceRef="Store_CreatePendingConfirmationQueue" targetRef="Queue_SendPostFactumConfirmation"/>
    <bpmn:sequenceFlow id="Flow_51" sourceRef="Queue_SendPostFactumConfirmation" targetRef="Gateway_PostFactumSent"/>
    <bpmn:sequenceFlow id="Flow_52_yes" sourceRef="Gateway_PostFactumSent" targetRef="Store_MarkQueueDone" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_52_no" sourceRef="Gateway_PostFactumSent" targetRef="Store_DeletePendingOnNotificationFailure" name="No"/>
    <bpmn:sequenceFlow id="Flow_53" sourceRef="Store_DeletePendingOnNotificationFailure" targetRef="Store_RequeueTask"/>
    <bpmn:sequenceFlow id="Flow_54" sourceRef="Store_RequeueTask" targetRef="End_QueueDeferred"/>
    <bpmn:sequenceFlow id="Flow_55" sourceRef="Store_MarkQueueDone" targetRef="Gateway_ConfirmationAction"/>

    <bpmn:textAnnotation id="TextAnnotation_RuntimeAndUXNotes">
      <bpmn:text>Runtime notes: online ingress can run through main_polling.py or main_webhook.py; both entrypoints execute startup_preflight and use the same TelegramPollingHandler. Auxiliary lightweight UI branches (Help, Show Example, input cancel, Main Menu, Report Another) are intentionally omitted from the primary BPMN path for readability.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ProcessingNotes">
      <bpmn:text>Processing notes: raw_text is always preserved inside the pending confirmation record and later in data_facts. Online and deferred paths both classify -> normalize -> validate -> map valid/fallback -> create a pending confirmation. Google Sheets write happens only after explicit user confirmation. If save fails on Confirm, the pending draft is intentionally kept so the user can retry. Queue requeue persists attempt_count and next_attempt_at with bounded backoff and jitter.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_LoggingNotes">
      <bpmn:text>Structured logging reflected in this BPMN: startup_preflight_started/passed/failed, polling_started, webhook_started, queue_worker_bootstrap_started, queue_worker_started, message_received, llm_response_received, llm_timeout, json_validation_passed/failed, queue_enqueued, queue_enqueue_failed, queue_dequeued, queue_processing_failed, sheets_write_success/failed, post_factum_notification_sent, classification_failed, telegram_update_error.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_RuntimeAndUXNotes" sourceRef="Bot_SendWelcome" targetRef="TextAnnotation_RuntimeAndUXNotes"/>
    <bpmn:association id="Association_ProcessingNotes" sourceRef="Sheets_WriteConfirmedRecord" targetRef="TextAnnotation_ProcessingNotes"/>
    <bpmn:association id="Association_LoggingNotes" sourceRef="Store_RequeueTask" targetRef="TextAnnotation_LoggingNotes"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_CivilEngineerClassifierBot">
    <bpmndi:BPMNPlane id="BPMNPlane_CivilEngineerClassifierBot" bpmnElement="Process_CivilEngineerClassifierBot">
      <bpmndi:BPMNShape id="Shape_Lane_User" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="120" y="100" width="5600" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Telegram" bpmnElement="Lane_Telegram" isHorizontal="true">
        <dc:Bounds x="120" y="260" width="5600" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Bot" bpmnElement="Lane_Bot" isHorizontal="true">
        <dc:Bounds x="120" y="360" width="5600" height="230"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Stores" bpmnElement="Lane_Stores" isHorizontal="true">
        <dc:Bounds x="120" y="590" width="5600" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_QueueWorker" bpmnElement="Lane_QueueWorker" isHorizontal="true">
        <dc:Bounds x="120" y="760" width="5600" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sheets" bpmnElement="Lane_Sheets" isHorizontal="true">
        <dc:Bounds x="120" y="980" width="5600" height="120"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_UserOpensChat" bpmnElement="Start_UserOpensChat">
        <dc:Bounds x="160" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_User_OpenChat" bpmnElement="User_OpenChat">
        <dc:Bounds x="220" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_User_PressStart" bpmnElement="User_PressStart">
        <dc:Bounds x="380" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Bot_SendWelcome" bpmnElement="Bot_SendWelcome">
        <dc:Bounds x="540" y="435" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_User_PressReportProgress" bpmnElement="User_PressReportProgress">
        <dc:Bounds x="710" y="140" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Bot_SendInputInstruction" bpmnElement="Bot_SendInputInstruction">
        <dc:Bounds x="880" y="435" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_User_SendFreeText" bpmnElement="User_SendFreeText">
        <dc:Bounds x="1050" y="140" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TG_ReceiveUpdate" bpmnElement="TG_ReceiveUpdate">
        <dc:Bounds x="1220" y="270" width="140" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Bot_PreprocessText" bpmnElement="Bot_PreprocessText">
